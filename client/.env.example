# Postgres (en Vercel: Storage → Neon, crea DATABASE_URL automáticamente)
DATABASE_URL=postgres://usuario:clave@host:5432/base
# Cadena aleatoria larga para firmar sesiones del panel
PAYLOAD_SECRET=
# URL pública del sitio
NEXT_PUBLIC_SERVER_URL=https://www.ccalajuela.ed.cr
# Vercel Blob (Storage → Blob). Sin esto, los archivos se guardan en ./media
BLOB_READ_WRITE_TOKEN=
